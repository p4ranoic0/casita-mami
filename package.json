  "type": "module",
  "scripts": {
    "dev": "node scripts/images.mjs && vite",
    "build": "node scripts/build.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "dev:galeria": "node scripts/images.mjs && vite --config vite.galeria.config.js",
